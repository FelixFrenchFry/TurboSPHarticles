{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_FEATURE_FLAGS": "manifests",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_installed",
        "ENABLE_CUDA": "ON",
        "ENABLE_VIS": "ON"
      }
    },

    {
      "name": "base-win",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "base-linux",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "base-win-mpi",
      "hidden": true,
      "inherits": "base-win",
      "cacheVariables": {
        "ENABLE_CUDA": "OFF",
        "ENABLE_VIS": "OFF",
        "ENABLE_MPI": "ON"
      }
    },

    {
      "name": "base-linux-mpi",
      "hidden": true,
      "inherits": "base-linux",
      "cacheVariables": {
        "ENABLE_CUDA": "OFF",
        "ENABLE_VIS": "OFF",
        "ENABLE_MPI": "ON"
      }
    },

    {
      "name": "Windows-x64-Debug-Visual-CUDA",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Windows-x64-RelWithDebInfo-Visual-CUDA",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Windows-x64-Release-Visual-CUDA",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Windows-x64-Debug-Headless-CPU-MPI",
      "inherits": "base-win-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Windows-x64-RelWithDebInfo-Headless-CPU-MPI",
      "inherits": "base-win-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Windows-x64-Release-Headless-CPU-MPI",
      "inherits": "base-win-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    },

    {
      "name": "Linux-x64-Debug-Visual-CUDA",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux-x64-RelWithDebInfo-Visual-CUDA",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Linux-x64-Release-Visual-CUDA",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Linux-x64-Release-Headless-CUDA",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_VIS": "OFF"
      }
    },
    {
      "name": "Linux-arm64-Release-Headless-CUDA",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_VIS": "OFF",
        "TSP_CPU_SIMD_ARCH": "NEON64",
        "VCPKG_TARGET_TRIPLET": "arm64-linux",
        "VCPKG_HOST_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "Linux-x64-Debug-Headless-CPU-MPI",
      "inherits": "base-linux-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux-x64-RelWithDebInfo-Headless-CPU-MPI",
      "inherits": "base-linux-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Linux-x64-Release-Headless-CPU-MPI",
      "inherits": "base-linux-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/build/${presetName}/vcpkg_installed",
        "BUILD_TESTING": "ON",
        "ENABLE_SCENARIO_TESTS": "OFF",
        "ENABLE_CUDA": "OFF",
        "ENABLE_VIS": "OFF",
        "ENABLE_MPI": "OFF",
        "TSP_CPU_SIMD_ARCH": "AVX256"
      }
    },
    {
      "name": "ci-linux",
      "hidden": true,
      "inherits": [ "ci", "base-linux" ]
    },
    {
      "name": "CI-Linux-x64-Headless-CPU-Tests",
      "inherits": "ci-linux"
    },
    {
      "name": "CI-Windows-x64-Headless-CPU-Tests",
      "inherits": [ "ci", "base-win" ]
    },
    {
      "name": "CI-Linux-x64-Headless-CPU-Tests-ASan-UBSan",
      "inherits": "CI-Linux-x64-Headless-CPU-Tests",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "CI-Linux-x64-Headless-CPU-MPI-Tests",
      "inherits": "CI-Linux-x64-Headless-CPU-Tests",
      "cacheVariables": {
        "ENABLE_MPI": "ON"
      }
    },
    {
      "name": "CI-Linux-x64-Headless-CPU-Tests-AVX512",
      "inherits": "CI-Linux-x64-Headless-CPU-Tests",
      "cacheVariables": {
        "TSP_CPU_SIMD_ARCH": "AVX512"
      }
    },
    {
      "name": "CI-Windows-x64-Headless-CPU-Tests-AVX512",
      "inherits": "CI-Windows-x64-Headless-CPU-Tests",
      "cacheVariables": { "TSP_CPU_SIMD_ARCH": "AVX512" }
    },
    {
      "name": "CI-Linux-x64-Release-Headless-CUDA-Tests",
      "inherits": "ci-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_CUDA": "ON",
        "CMAKE_CUDA_HOST_COMPILER": "g++-13"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "Windows-x64-Debug-Visual-CUDA",
      "configurePreset": "Windows-x64-Debug-Visual-CUDA"
    },
    {
      "name": "Windows-x64-RelWithDebInfo-Visual-CUDA",
      "configurePreset": "Windows-x64-RelWithDebInfo-Visual-CUDA"
    },
    {
      "name": "Windows-x64-Release-Visual-CUDA",
      "configurePreset": "Windows-x64-Release-Visual-CUDA"
    },
    {
      "name": "Windows-x64-Debug-Headless-CPU-MPI",
      "configurePreset": "Windows-x64-Debug-Headless-CPU-MPI"
    },
    {
      "name": "Windows-x64-RelWithDebInfo-Headless-CPU-MPI",
      "configurePreset": "Windows-x64-RelWithDebInfo-Headless-CPU-MPI"
    },
    {
      "name": "Windows-x64-Release-Headless-CPU-MPI",
      "configurePreset": "Windows-x64-Release-Headless-CPU-MPI"
    },

    {
      "name": "Linux-x64-Debug-Visual-CUDA",
      "configurePreset": "Linux-x64-Debug-Visual-CUDA"
    },
    {
      "name": "Linux-x64-RelWithDebInfo-Visual-CUDA",
      "configurePreset": "Linux-x64-RelWithDebInfo-Visual-CUDA"
    },
    {
      "name": "Linux-x64-Release-Visual-CUDA",
      "configurePreset": "Linux-x64-Release-Visual-CUDA"
    },
    {
      "name": "Linux-x64-Release-Headless-CUDA",
      "configurePreset": "Linux-x64-Release-Headless-CUDA"
    },
    {
      "name": "Linux-arm64-Release-Headless-CUDA",
      "configurePreset": "Linux-arm64-Release-Headless-CUDA"
    },
    {
      "name": "Linux-x64-Debug-Headless-CPU-MPI",
      "configurePreset": "Linux-x64-Debug-Headless-CPU-MPI"
    },
    {
      "name": "Linux-x64-RelWithDebInfo-Headless-CPU-MPI",
      "configurePreset": "Linux-x64-RelWithDebInfo-Headless-CPU-MPI"
    },
    {
      "name": "Linux-x64-Release-Headless-CPU-MPI",
      "configurePreset": "Linux-x64-Release-Headless-CPU-MPI"
    }
  ]
}
