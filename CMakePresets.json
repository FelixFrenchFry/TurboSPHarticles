{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_FEATURE_FLAGS": "manifests",
        "ENABLE_CUDA": "ON",
        "ENABLE_VIS": "ON"
      }
    },

    // windows
    {
      "name": "Win-x64-Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/win-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_BUILD_TYPE": "debug"
      }
    },
    {
      "name": "Win-x64-RelWithDeb",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/win-x64-relwithdeb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Win-x64-Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/win-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_BUILD_TYPE": "release"
      }
    },

    // linux
    {
      "name": "Linux-x64-Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_BUILD_TYPE": "debug"
      }
    },
    {
      "name": "Linux-x64-RelWithDeb",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/linux-x64-relwithdeb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Linux-x64-Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_BUILD_TYPE": "release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "Win-x64-Debug",
      "configurePreset": "Win-x64-Debug"
    },
    {
      "name": "Win-x64-RelWithDeb",
      "configurePreset": "Win-x64-RelWithDeb"
    },
    {
      "name": "Win-x64-Release",
      "configurePreset": "Win-x64-Release"
    },
    {
      "name": "Linux-x64-Debug",
      "configurePreset": "Linux-x64-Debug"
    },
    {
      "name": "Linux-x64-RelWithDeb",
      "configurePreset": "Linux-x64-RelWithDeb"
    },
    {
      "name": "Linux-x64-Release",
      "configurePreset": "Linux-x64-Release"
    }
  ]
}
