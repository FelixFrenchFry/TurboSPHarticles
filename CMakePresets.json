{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_FEATURE_FLAGS": "manifests",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_installed",
        "ENABLE_CUDA": "ON",
        "ENABLE_VIS": "ON"
      }
    },

    {
      "name": "base-win",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "base-linux",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "base-win-mpi",
      "hidden": true,
      "inherits": "base-win",
      "cacheVariables": {
        "ENABLE_CUDA": "OFF",
        "ENABLE_VIS": "OFF",
        "ENABLE_MPI": "ON"
      }
    },

    {
      "name": "base-linux-mpi",
      "hidden": true,
      "inherits": "base-linux",
      "cacheVariables": {
        "ENABLE_CUDA": "OFF",
        "ENABLE_VIS": "OFF",
        "ENABLE_MPI": "ON"
      }
    },

    {
      "name": "Windows-Debug",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Windows-RelWithDeb",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Windows-Release",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Windows-Debug-MPI",
      "inherits": "base-win-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Windows-RelWithDeb-MPI",
      "inherits": "base-win-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Windows-Release-MPI",
      "inherits": "base-win-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    },

    {
      "name": "Linux-Debug",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux-RelWithDeb",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Linux-Release",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Linux-Release-CUDA",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TSP_CUDA_ARCHITECTURE": "80;90",
        "ENABLE_VIS": "OFF"
      }
    },
    {
      "name": "Linux-Debug-MPI",
      "inherits": "base-linux-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux-RelWithDeb-MPI",
      "inherits": "base-linux-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_BUILD_TYPE": "release"
      }
    },
    {
      "name": "Linux-Release-MPI",
      "inherits": "base-linux-mpi",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_BUILD_TYPE": "release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "Windows-Debug",
      "configurePreset": "Windows-Debug"
    },
    {
      "name": "Windows-RelWithDeb",
      "configurePreset": "Windows-RelWithDeb"
    },
    {
      "name": "Windows-Release",
      "configurePreset": "Windows-Release"
    },
    {
      "name": "Windows-Debug-MPI",
      "configurePreset": "Windows-Debug-MPI"
    },
    {
      "name": "Windows-RelWithDeb-MPI",
      "configurePreset": "Windows-RelWithDeb-MPI"
    },
    {
      "name": "Windows-Release-MPI",
      "configurePreset": "Windows-Release-MPI"
    },

    {
      "name": "Linux-Debug",
      "configurePreset": "Linux-Debug"
    },
    {
      "name": "Linux-RelWithDeb",
      "configurePreset": "Linux-RelWithDeb"
    },
    {
      "name": "Linux-Release",
      "configurePreset": "Linux-Release"
    },
    {
      "name": "Linux-Release-CUDA",
      "configurePreset": "Linux-Release-CUDA"
    },
    {
      "name": "Linux-Debug-MPI",
      "configurePreset": "Linux-Debug-MPI"
    },
    {
      "name": "Linux-RelWithDeb-MPI",
      "configurePreset": "Linux-RelWithDeb-MPI"
    },
    {
      "name": "Linux-Release-MPI",
      "configurePreset": "Linux-Release-MPI"
    }
  ]
}
