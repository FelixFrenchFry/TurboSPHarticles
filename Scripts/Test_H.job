#!/bin/bash -x
#SBATCH --job-name=Test_H
#SBATCH --partition=highmem
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=96
#SBATCH --time=4:00:00
#SBATCH --mem=2300000mb
#SBATCH --output=job_%j.out
#SBATCH --error=job_%j.err

# module
module purge
module load compiler/gnu/14.2

# toolchain vars
export CC=gcc
export CXX=g++
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export TBB_NUM_THREADS=$SLURM_CPUS_PER_TASK

# build location
cd /pfs/work9/workspace/scratch/fr_fl184-particleBench/TurboSPHarticles

# run
./out/build/Linux-x64-RelWithDeb/bin/TSP_Headless -p H
