#!/bin/bash -x
#SBATCH --job-name=Test_S
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --time=18:00:00
#SBATCH --mem=95000mb
#SBATCH --output=job_%j.out
#SBATCH --error=job_%j.err

# module
module purge
module load toolkit/nvidia-hpc-sdk/25.1

# toolchain vars
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export TBB_NUM_THREADS=$SLURM_CPUS_PER_TASK

# build location
cd /pfs/work9/workspace/scratch/fr_fl184-TurboSPHarticles-cuda/TurboSPHarticles

# run
./out/build/Linux-x64-RelWithDeb-cuda/bin/TSP_Headless -p S
