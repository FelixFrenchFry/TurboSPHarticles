#!/bin/bash -x
#SBATCH --job-name=Run_D
#SBATCH --partition=cpu
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=48
#SBATCH --threads-per-core=1
#SBATCH --time=72:00:00
#SBATCH --mem=380000mb
#SBATCH --output=job_%j.out
#SBATCH --error=job_%j.err

# module
module load compiler/intel/2025.0
module load mpi/impi/2021.14-intel-2025.0

# toolchain vars
unset CFLAGS CXXFLAGS CPPFLAGS FFLAGS FCFLAGS LDFLAGS
export CC=gcc
export CXX=g++

# process pinning
export I_MPI_PIN=1
export I_MPI_PIN_RESPECT_CPUSET=disable
export I_MPI_PIN_CELL=core
export I_MPI_PIN_DOMAIN="$SLURM_CPUS_PER_TASK"
export I_MPI_PIN_ORDER=compact
export I_MPI_DEBUG=4

# build location
cd /pfs/work9/workspace/scratch/fr_fl184-TSP_Runs/TurboSPHarticles

# run
mpiexec.hydra -bootstrap slurm -n "$SLURM_NTASKS" ./out/build/Linux-Release-MPI/bin/TSP_Distributed --sim maxThreadsSim="$SLURM_CPUS_PER_TASK" -p D
rc=$?; if [ $rc -ne 0 ]; then exit $rc; fi
