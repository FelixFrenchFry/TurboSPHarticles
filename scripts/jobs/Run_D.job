#!/bin/bash -x
#SBATCH --job-name=Run_D
#SBATCH --partition=cpu
#SBATCH --nodes=3
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=24
#SBATCH --threads-per-core=1
#SBATCH --time=72:00:00
#SBATCH --mem=380000mb
#SBATCH --output=job_%j.out
#SBATCH --error=job_%j.err

# module
module load compiler/intel/2025.0
module load mpi/impi/2021.14-intel-2025.0

# toolchain vars
unset CFLAGS CXXFLAGS CPPFLAGS FFLAGS FCFLAGS LDFLAGS
export CC=gcc
export CXX=g++
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# build location
cd /pfs/work9/workspace/scratch/fr_fl184-TSP_Runs/TurboSPHarticles

# run
mpiexec.hydra -bootstrap slurm -n 12 ./out/build/Linux-Release-MPI/bin/TSP_Distributed --sim maxThreadsSim=24 -p D
rc=$?; if [ $rc -ne 0 ]; then exit $rc; fi
