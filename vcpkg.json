{
  "name": "turbospharticles",
  "version": "0.1.0",
  "builtin-baseline": "7213cf8135c329c37c7e2778e40774489a0583a8",
  "dependencies": [
    "tbb",
    "spdlog",
    "nlohmann-json",
    "cli11",
    "boost-container",
    "glm",
    "xsimd"
  ],
  "features": {
    "tests": {
      "description": "Maintained GoogleTest tests",
      "dependencies": [ "gtest" ]
    },
    "visualization": {
      "description": "Visual interface and particle rendering",
      "dependencies": [
        "glfw3",
        "glad",
        {
          "name": "imgui",
          "features": [ "glfw-binding", "opengl3-binding", "docking-experimental" ]
        },
        "opengl"
      ]
    }
  }
}
